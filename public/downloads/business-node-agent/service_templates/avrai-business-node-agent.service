[Unit]
Description=AVRAI Business Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=AVRAI_BUSINESS_NODE_AGENT_PATH=__AVRAI_BUSINESS_NODE_AGENT_PATH__
Environment=AVRAI_BUSINESS_NODE_LAUNCH_EXPORT=__AVRAI_BUSINESS_NODE_LAUNCH_EXPORT__
Environment=AVRAI_BUSINESS_NODE_CALLBACK_URL=__AVRAI_BUSINESS_NODE_CALLBACK_URL__
Environment=AVRAI_BUSINESS_NODE_STATE_PATH=__AVRAI_BUSINESS_NODE_STATE_PATH__
ExecStart=${AVRAI_BUSINESS_NODE_AGENT_PATH} --launch-export ${AVRAI_BUSINESS_NODE_LAUNCH_EXPORT} --callback-url ${AVRAI_BUSINESS_NODE_CALLBACK_URL} --service --state-path ${AVRAI_BUSINESS_NODE_STATE_PATH} --heartbeat-interval 60
Restart=always
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
